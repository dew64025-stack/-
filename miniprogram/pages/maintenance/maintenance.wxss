.stack {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.w-full {
  width: 100%;
  box-sizing: border-box;
}

/* 顶部沙盒横幅 */
.banner {
  background: var(--surface-container-high);
  border-radius: 24rpx;
  padding: 16rpx 20rpx;
}
.dot-green {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--secondary);
  flex-shrink: 0;
}

/* 冲突案例卡片 */
.section-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 24rpx;
}
.t3-soft {
  background: rgba(92, 22, 0, 0.1);
}
.p-soft {
  background: rgba(0, 50, 75, 0.1);
}
.req-id {
  background: var(--surface-low);
  border-radius: 12rpx;
  padding: 8rpx 20rpx;
}
.detail-well {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.info-box {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: var(--surface-container);
  border-radius: 12rpx;
  padding: 16rpx;
  margin-top: 8rpx;
}

/* 推荐席位卡片 */
.rec-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(165, 243, 201, 0.4);
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
}
.rec-card.plain {
  background: var(--surface-container);
}

/* 版本冲突 */
.ver-chip {
  background: var(--surface-container-highest);
  color: var(--on-surface-variant);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
}
.ver-chip.latest {
  background: var(--secondary-container);
  color: var(--on-secondary-container);
  font-weight: 600;
}
.ver-code {
  background: var(--surface-container-highest);
  color: var(--primary);
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  font-size: 22rpx;
}
.protect {
  padding: 0 8rpx;
}

/* 底部 */
.center-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  text-align: center;
}

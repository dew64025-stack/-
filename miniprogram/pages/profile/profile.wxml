<import src="../../templates/api-state.wxml"/>
<view class="page col pg main-tab-page">
  <view class="card col gap-md"><view class="row space-between"><view class="row gap-sm flex-1"><image wx:if="{{user.avatarUrl}}" class="avatar-ph" src="{{user.avatarUrl}}"/><view class="col flex-1"><text class="headline-sm">{{loggedIn ? (user.nickname || '微信用户') : '登录后使用更多服务'}}</text><text class="caption muted">{{user.phoneMasked || '手机号未绑定'}}</text></view></view><view class="row profile-actions"><button class="profile-settings row gap-xs" bindtap="openSettings"><image class="profile-settings-icon" src="../../assets/profile-icons/settings.svg" mode="aspectFit"/><text>设置</text></button><button wx:if="{{loggedIn}}" class="link-btn" bindtap="editProfile">编辑资料 ›</button></view></view><view wx:if="{{loggedIn}}" class="well col gap-sm"><text class="label-md">学生认证：{{user.verificationLabel}}</text><text class="body-sm">{{profile.college || '院系未填写'}} · {{profile.grade || '年级未填写'}}</text><view class="api-actions"><button class="btn btn-outline btn-xs" bindtap="goVerify">学生认证</button><button class="btn btn-outline btn-xs" bindtap="goPhone">手机号管理</button></view></view><button wx:else class="btn btn-primary" bindtap="goLogin">微信登录</button></view>
  <template is="api-state" data="{{loading,error,needsLogin}}"/>
  <view wx:if="{{loggedIn}}" class="row gap-sm stats"><button class="stat-item col center" data-type="todos" bindtap="openItems"><text class="headline-lg primary-text">{{dashboard.todoCount || 0}}</text><text class="caption">我的待办</text></button><button class="stat-item col center" data-type="reservations" bindtap="openItems"><text class="headline-lg primary-text">{{dashboard.reservationCount || 0}}</text><text class="caption">我的预约</text></button><button class="stat-item col center" data-type="workorders" bindtap="openItems"><text class="headline-lg primary-text">{{dashboard.workOrderCount || 0}}</text><text class="caption">服务工单</text></button><button class="stat-item col center" data-type="posts" bindtap="openItems"><text class="headline-lg primary-text">{{dashboard.postCount || 0}}</text><text class="caption">我的发布</text></button></view>
  <view class="card col gap-sm"><view class="api-heading"><view class="row gap-xs"><view class="icon-round icon-round-sm vault-ico"><image class="vault-icon-image" src="../../assets/profile-icons/vault.png" mode="aspectFit"/></view><text class="headline-sm">材料保险箱</text></view><button class="link-btn" bindtap="openVault">管理 ›</button></view><view wx:for="{{materials}}" wx:key="id" class="doc-row col gap-xs"><text class="label-md">{{item.fileName}}</text><text class="caption muted">{{item.statusLabel}} · {{item.scanStatus}}</text></view><text wx:if="{{!materials.length}}" class="api-empty">{{loggedIn ? '暂无个人材料' : '登录后查看个人材料'}}</text><button class="btn btn-primary" bindtap="openVault">管理材料与授权</button></view>
  <view class="card col gap-sm"><view class="row gap-xs"><view class="icon-round icon-round-sm growth-ico"><image class="profile-section-image" src="../../assets/profile-icons/growth-archive.png" mode="aspectFit"/></view><text class="headline-sm">学生个人成长档案</text></view><view wx:for="{{growth}}" wx:key="id" class="growth-item col gap-xs"><text class="label-md">{{item.title}}</text><text class="body-sm muted">{{item.description}}</text><text class="caption muted">{{item.dateText}} · {{item.confirmed ? '已核验' : '未核验'}}</text></view><text wx:if="{{!growth.length}}" class="api-empty">暂无成长记录</text></view>
  <view class="card col gap-sm"><view class="row gap-xs"><view class="icon-round icon-round-sm credit-ico"><image class="profile-section-image" src="../../assets/profile-icons/credit-review.png" mode="aspectFit"/></view><text class="headline-sm">信用记录与纠错中心</text></view><view wx:for="{{credit}}" wx:key="id" class="well col gap-sm"><text class="label-md">{{item.reason}}</text><text class="caption muted">{{item.eventType}} · {{item.points}} 分 · {{item.dateText}}</text><button class="link-btn" bindtap="dispute" data-id="{{item.id}}">申请异议复核</button></view><text wx:if="{{!credit.length}}" class="api-empty">暂无信用事件</text></view>
  <button wx:if="{{loggedIn}}" class="btn btn-outline" bindtap="openBorrows">我的借用与归还</button>
  <button wx:if="{{loggedIn}}" class="btn btn-outline" data-type="inbox" bindtap="openItems">消息与通知 · {{dashboard.unreadCount || 0}}</button>
  <button class="btn btn-outline admin-entry" bindtap="openAdmin" disabled="{{busy}}">教职工／管理员入口</button>
</view>

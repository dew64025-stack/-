.login-page {
  padding-bottom: 60rpx;
}

/* 状态栏 */
.status-bar {
  background: var(--surface-container);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 32rpx;
}
.status-ico {
  color: var(--primary-container);
}
.status-text {
  color: var(--primary-container);
}

/* 品牌区 */
.brand {
  padding: 0 16rpx;
}
.logo-wrap {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #07c160 0%, #00324b 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: rgba(7, 193, 96, 0.25) 0px 4px 16px;
}
.logo-ico {
  font-size: 72rpx;
  color: var(--on-primary);
}
.logo-ai {
  position: absolute;
  right: -12rpx;
  bottom: -8rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #06ad56;
  color: #ffffff;
  font-size: 18rpx;
  line-height: 1.4;
}
.brand-title {
  margin-top: 24rpx;
}
.brand-sub {
  margin-top: 8rpx;
}
.brand-pill {
  margin-top: 20rpx;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #e8f8f0;
  color: #005235;
  border: 1rpx solid rgba(7, 193, 96, 0.2);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}
.brand-pill .ico {
  color: #07c160;
}

/* 校区卡片 */
.campus-card {
  margin-top: 32rpx;
}
.campus-head {
  align-items: flex-start;
  gap: 16rpx;
}
.campus-icon {
  background: var(--surface-low);
}
.campus-sub {
  margin-top: 4rpx;
}
.campus-lock {
  margin-top: 20rpx;
  padding: 12rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(240, 243, 255, 0.7);
  align-items: flex-start;
}

/* 登录操作 */
.login-actions {
  gap: 20rpx;
  margin-top: 32rpx;
}
.wx-login-btn {
  background: #07c160;
  color: #ffffff;
  height: 96rpx;
  box-shadow: rgba(7, 193, 96, 0.25) 0px 4px 12px;
}
.guest-btn {
  background: #ffffff;
  color: var(--on-surface);
  height: 88rpx;
  border: 1rpx solid #d1f2e4;
}
.guest-ico {
  color: #07c160;
}
.guest-note {
  text-align: center;
  margin-top: -12rpx;
  padding: 0 32rpx;
}

/* 协议卡片 */
.agree-card {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.agree-top {
  align-items: flex-start;
  gap: 16rpx;
}
.checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 4rpx;
}
.checkbox-on {
  background: #07c160;
}
.checkbox-off {
  background: var(--surface-container-highest);
}
.checkbox-tick {
  font-size: 24rpx;
  color: #ffffff;
}
.agree-text {
  line-height: 1.5;
}
.agree-link {
  color: #07c160;
  font-weight: 500;
}
.promise-box {
  background: #e8f8f0;
  border: 1rpx solid rgba(7, 193, 96, 0.15);
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.promise-item {
  align-items: center;
  gap: 12rpx;
}
.promise-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--secondary);
  flex-shrink: 0;
}

/* 底部备案 */
.footer {
  margin-top: 32rpx;
  gap: 8rpx;
}
.footer-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  background: #e8f8f0;
  color: #005235;
  border: 1rpx solid rgba(7, 193, 96, 0.2);
}
.footer-badge .ico {
  color: #07c160;
}
.footer-no {
  margin-top: 8rpx;
}
.footer-dis {
  margin-top: 4rpx;
}

<import src="../../templates/api-state.wxml"/>
<view class="page api-page"><template is="api-state" data="{{loading,error,needsLogin}}"/><block wx:if="{{detail}}"><view class="card col gap-sm"><view class="badge badge-primary">{{detail.categoryLabel}}</view><text class="headline-sm">{{detail.title}}</text><text class="body-sm api-content">{{detail.summary}}</text><text class="caption muted">截止：{{detail.dateText}}</text><text class="api-source">来源：{{detail.sourceName || detail.organizer}}</text><text wx:if="{{detail.isStale}}" class="caption error-text">来源信息已过期，请核对官方通知</text><view class="api-actions"><button class="btn btn-outline btn-xs" bindtap="favorite" disabled="{{busy}}">{{detail.isFavorited ? '取消收藏' : '收藏机会'}}</button><button class="btn btn-outline btn-xs" bindtap="reminder" disabled="{{busy}}">截止提醒</button><button class="btn btn-outline btn-xs" bindtap="openReference">复制原文链接</button></view></view>
<view wx:if="{{detail.notice}}" class="card col gap-sm"><text class="headline-sm">通知原文</text><text class="body-sm api-content">{{detail.notice.content}}</text></view>
<view class="card col gap-sm"><text class="headline-sm">资格与材料</text><view wx:for="{{detail.materialRequirements}}" wx:key="name" class="well col gap-xs"><text class="label-md">{{item.name}} · {{item.required ? '必需' : '可选'}}</text><text class="caption muted">{{item.description}}</text></view><text wx:if="{{!detail.materialRequirements.length}}" class="api-empty">尚未公布材料要求</text><view class="api-actions"><button class="btn btn-primary btn-sm" bindtap="checkEligibility" loading="{{busy}}" disabled="{{busy}}">资格匹配</button><button class="btn btn-secondary btn-sm" bindtap="checklist">材料清单与预检</button></view><view wx:if="{{eligibility}}" class="well col gap-xs"><text>核验结论：{{eligibility.conclusion}}</text><text wx:for="{{eligibility.reasons}}" wx:key="index" class="body-sm">{{item.message || item.reason || item.field}}</text></view></view><button class="btn btn-outline" bindtap="teams">竞赛组队 · {{detail.teamCount}} 支队伍</button></block></view>

<import src="../../templates/api-state.wxml"/><view class="page api-page"><view class="api-actions"><button class="btn {{side === 'borrower' ? 'btn-primary' : 'btn-outline'}}" bindtap="side" data-side="borrower">我借入的</button><button class="btn {{side === 'owner' ? 'btn-primary' : 'btn-outline'}}" bindtap="side" data-side="owner">我借出的</button></view><template is="api-state" data="{{loading,error,needsLogin}}"/><view wx:for="{{entries}}" wx:key="id" class="card col gap-sm"><text class="headline-sm">借用单 {{item.id}}</text><text class="caption muted">{{item.borrowerDisplayName}} · {{item.statusLabel}}</text><view class="api-actions"><button class="btn btn-outline btn-xs" data-id="{{item.id}}" bindtap="contact">站内沟通</button><button wx:if="{{side === 'owner' && item.status === 'pending'}}" class="btn btn-primary btn-xs" data-id="{{item.id}}" data-action="approve" bindtap="transition">同意借用</button><button wx:if="{{item.status === 'pending' || item.status === 'confirmed'}}" class="btn btn-outline btn-xs" data-id="{{item.id}}" data-action="cancel" bindtap="transition">取消借用</button><button wx:if="{{item.status === 'confirmed'}}" class="btn btn-primary btn-xs" data-id="{{item.id}}" data-action="confirm_handover" bindtap="transition">确认线下交接</button><button wx:if="{{item.status === 'handed_over'}}" class="btn btn-primary btn-xs" data-id="{{item.id}}" data-action="confirm_return" bindtap="transition">确认物品归还</button><button wx:if="{{item.status === 'returned'}}" class="btn btn-outline btn-xs" data-post="{{item.postId}}" bindtap="rate">履约评价</button></view></view><text wx:if="{{!loading && !entries.length}}" class="api-empty">暂无借用记录</text></view>

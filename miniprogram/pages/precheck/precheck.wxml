<import src="../../templates/api-state.wxml"/><view class="page api-page"><template is="api-state" data="{{loading,error,needsLogin}}"/><view class="api-heading"><text class="headline-sm">申报材料清单</text><button class="btn btn-outline btn-xs" bindtap="openVault">打开保险箱</button></view><view wx:if="{{checklist}}" class="card col gap-md"><view wx:for="{{checklist.items}}" wx:key="id" class="well col gap-sm"><text class="label-md">{{item.itemName}} · {{item.required ? '必需' : '可选'}}</text><text class="caption muted">状态：{{item.status}} {{item.materialVersionId ? '· 已绑定材料版本' : ''}}</text><picker range="{{materials}}" range-key="fileName" bindchange="bindItem" data-id="{{item.id}}" disabled="{{busy}}"><view class="api-picker">选用本人材料 ›</view></picker><button wx:if="{{item.materialVersionId}}" class="btn btn-outline btn-xs" bindtap="clearItem" data-id="{{item.id}}" disabled="{{busy}}">解除绑定</button></view><text wx:if="{{!checklist.items.length}}" class="api-empty">该机会尚未配置材料清单</text><button class="btn btn-primary" bindtap="recheck" disabled="{{busy}}" loading="{{busy}}">发起材料预检</button><button class="btn btn-outline" bindtap="markSubmitted" disabled="{{busy}}">记录已正式提交</button></view><view wx:if="{{report}}" class="card col gap-sm"><text class="headline-sm">预检结果 · {{report.status}}</text><text wx:if="{{report.stale}}" class="error-text">材料或规则已变化，此结果已过期，请重新预检</text><view wx:for="{{report.results}}" wx:key="checklistItemId" class="well col gap-xs"><text>{{item.level}} · {{item.itemKey}}</text><text class="body-sm">{{item.message}}</text></view><text class="caption muted">预检用于辅助准备，不替代学校或主办方审核。</text></view></view>

.stack {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.w-full {
  width: 100%;
  box-sizing: border-box;
}

/* 合规提示条 */
.compliance-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--surface-container-high);
  border-radius: 24rpx;
  padding: 16rpx 20rpx;
}

/* 主错误卡片 */
.error-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx 24rpx;
}
.err-visual {
  margin-bottom: 8rpx;
}
.err-circle {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--error-container);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 0 24rpx rgba(255, 218, 214, 0.35);
}
.err-sub {
  position: absolute;
  bottom: -6rpx;
  right: -6rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--surface-lowest);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.12);
}

/* 离线草稿保护槽 */
.draft-well {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  background: rgba(165, 243, 201, 0.3);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  width: 100%;
  box-sizing: border-box;
}
.chip-time {
  background: rgba(26, 107, 74, 0.15);
  color: var(--secondary);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
}

/* 空态卡片 */
.card-head {
  padding-bottom: 16rpx;
  margin-bottom: 16rpx;
}
.empty-body {
  padding: 16rpx 0 8rpx;
}
.empty-ico {
  background: var(--surface-container-high);
  margin-bottom: 16rpx;
}
.empty-ico.green {
  background: rgba(165, 243, 201, 0.4);
}
.empty-tip {
  text-align: left;
  margin: 16rpx 0 24rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 底部合规 */
.foot-lines {
  margin-top: 16rpx;
}

/* 加载旋转 */
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.spin {
  display: inline-block;
  animation: spin 1s linear infinite;
}

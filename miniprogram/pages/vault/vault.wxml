<import src="../../templates/api-state.wxml"/><view class="page api-page"><view class="api-heading"><text class="headline-sm primary-text">材料保险箱</text><button class="btn btn-primary btn-sm" bindtap="upload" disabled="{{busy}}" loading="{{busy}}">上传材料</button></view><template is="api-state" data="{{loading,error,needsLogin}}"/><view class="card col gap-sm"><text class="body-sm muted">文件通过安全扫描后存入个人材料库，版本可复用到申报清单。</text><view class="api-heading"><text>材料 AI 预检授权</text><switch checked="{{aiAuthOn}}" bindchange="toggleAuth" disabled="{{busy || needsLogin}}"/></view></view><view class="search-box"><input class="search-input" value="{{query}}" bindinput="input" bindconfirm="reload" placeholder="搜索个人材料"/><button class="search-btn" bindtap="reload">搜索</button></view><view wx:for="{{materials}}" wx:key="id" class="card col gap-sm"><text class="headline-sm">{{item.fileName}}</text><text class="caption muted">版本 {{item.currentVersion.versionNo}} · {{item.scanStatus}} · {{item.sizeBytes}} 字节</text><view class="api-actions"><button class="btn btn-outline btn-xs" bindtap="preview" data-id="{{item.id}}" disabled="{{busy}}">查看文件</button><button class="btn btn-outline btn-xs" bindtap="append" data-id="{{item.id}}" disabled="{{busy}}">上传新版本</button><button class="btn btn-outline btn-xs" bindtap="remove" data-id="{{item.id}}" disabled="{{busy}}">删除</button></view></view><text wx:if="{{!loading && !materials.length}}" class="api-empty">暂无个人材料</text><button wx:if="{{hasMore}}" class="btn btn-outline" bindtap="onReachBottom">加载更多</button></view>

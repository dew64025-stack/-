<import src="../../templates/api-state.wxml"/><view class="page api-page"><template is="api-state" data="{{loading,error,needsLogin}}"/><block wx:if="{{detail}}"><view class="card col gap-sm"><text class="headline-sm">{{detail.title}}</text><text class="body-sm api-content">{{detail.description}}</text><text class="caption muted">{{detail.statusLabel}} · {{detail.voteCount}} 人支持 · {{detail.followCount}} 人关注</text><text class="api-source">{{detail.sourceName}}</text><view class="api-images"><image wx:for="{{detail.images}}" wx:key="id" class="api-image" src="{{item.url}}" mode="aspectFill"/></view><view class="api-actions"><button class="btn btn-primary btn-sm" bindtap="support">支持议题</button><button class="btn btn-outline btn-sm" bindtap="support" data-cancel="true">撤销支持</button><button class="btn btn-outline btn-sm" bindtap="follow">关注</button><button class="btn btn-outline btn-sm" bindtap="follow" data-cancel="true">取消关注</button><button class="btn btn-outline btn-sm" bindtap="evidence">补充证据</button></view></view></block><block wx:else><view class="api-actions"><button wx:if="{{crowdMode}}" class="btn btn-primary" bindtap="observe">提交拥堵观测</button><block wx:else><button class="btn btn-primary" bindtap="startCreate">提交校园建议</button><button class="btn btn-outline" bindtap="showMap">查看问题地图</button></block></view><map wx:if="{{markers.length}}" style="width:100%;height:450rpx" latitude="{{markers[0].latitude}}" longitude="{{markers[0].longitude}}" markers="{{markers}}"/><view wx:if="{{creating}}" class="card col gap-sm"><input class="api-form-input" placeholder="建议标题" value="{{title}}" data-field="title" bindinput="input" maxlength="256"/><picker range="{{categories}}" value="{{categoryIndex}}" bindchange="category"><view class="api-picker">分类：{{categories[categoryIndex]}}</view></picker><textarea class="api-form-textarea" placeholder="具体建议与问题描述" value="{{description}}" data-field="description" bindinput="input" maxlength="1024"/><button class="btn btn-primary" bindtap="create" disabled="{{busy}}">提交建议</button></view><view wx:for="{{entries}}" wx:key="id" class="card col gap-sm"><block wx:if="{{crowdMode}}"><text class="headline-sm">{{item.locationName}} · {{item.levelLabel}}</text><text class="api-source">{{item.sourceName}} · {{item.dateText}}</text></block><block wx:else><text class="headline-sm">{{item.title}}</text><text class="body-sm muted">{{item.description}}</text><button class="btn btn-outline btn-xs" data-id="{{item.id}}" bindtap="open">查看进度与参与</button></block></view><text wx:if="{{!loading && !entries.length}}" class="api-empty">暂无公开记录</text></block></view>

<import src="../../templates/api-state.wxml"/><view class="page api-page"><template is="api-state" data="{{loading,error,needsLogin}}"/><block wx:if="{{detail}}"><view class="card col gap-md"><view class="api-heading"><view class="badge badge-primary">{{detail.categoryLabel}}</view><text class="caption muted">{{detail.statusLabel}}</text></view><text class="headline-sm">{{detail.title}}</text><text class="body-sm api-content">{{detail.content}}</text><view class="api-images"><image wx:for="{{detail.images}}" wx:key="id" class="api-image" src="{{item.url}}" mode="aspectFill"/></view><text class="headline-sm tertiary-text">{{detail.priceText}}</text><text class="body-sm muted">{{detail.exchangeArea}}</text><text class="caption muted">发布者：{{detail.author.nickname || '校园用户'}}</text><view class="api-actions"><button class="btn btn-outline" bindtap="toggleFav">收藏（待开放）</button><button class="btn btn-primary" bindtap="onChat">站内联系</button><button wx:if="{{detail.category === 'borrow' && !detail.canEdit}}" class="btn btn-secondary" bindtap="openDrawer">申请借用</button></view><view wx:if="{{detail.canEdit}}" class="api-actions"><button class="btn btn-outline btn-xs" data-action="complete" bindtap="changeStatus">标记完成</button><button class="btn btn-outline btn-xs" data-action="cancel" bindtap="changeStatus">取消发布</button></view></view><view wx:if="{{showDrawer}}" class="card col gap-sm"><text class="headline-sm">借用申请</text><input class="api-form-input" value="{{startText}}" data-field="startText" bindinput="input" placeholder="开始：YYYY-MM-DD HH:mm（可协商）"/><input class="api-form-input" value="{{endText}}" data-field="endText" bindinput="input" placeholder="归还：YYYY-MM-DD HH:mm（可协商）"/><button class="btn btn-primary" bindtap="confirmSubmit" disabled="{{busy}}">提交借用申请</button><button class="btn btn-outline" bindtap="closeDrawer">取消</button></view><view class="card col gap-sm"><text class="headline-sm">历史评价</text><view wx:for="{{ratings}}" wx:key="id" class="well col gap-xs"><text>{{item.score}} 星</text><text class="body-sm">{{item.comment}}</text></view><text wx:if="{{!ratings.length}}" class="api-empty">暂无评价</text></view></block></view>

.stack {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.w-full {
  width: 100%;
  box-sizing: border-box;
}
.dot-green {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--secondary);
  flex-shrink: 0;
}

/* 警示区 */
.warn-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx 24rpx;
}
.shield-visual {
  margin: 8rpx 0 4rpx;
  gap: 12rpx;
}
.shield-core {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--surface-lowest);
  box-shadow: 0 0 0 20rpx rgba(0, 50, 75, 0.1), 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}
.lock-corner {
  position: absolute;
  top: 16rpx;
  right: 10rpx;
}
.gateway-label {
  background: var(--surface-container-highest);
  color: var(--primary);
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 2rpx 16rpx;
}
.trigger-card {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: var(--surface-container);
  width: 100%;
  box-sizing: border-box;
}

/* 权益卡片 */
.benefit {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}
.ben-ico.green {
  background: var(--secondary-container);
  color: var(--on-secondary-container);
}
.ben-ico.blue {
  background: var(--surface-container-high);
}

/* 核验表单 */
.form-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.input-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--surface-low);
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 88rpx;
  box-sizing: border-box;
}
.input-inner {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  color: var(--on-surface);
  background: transparent;
}
.phone-status {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--surface-low);
}
.phone-status .icon-round.green {
  background: var(--secondary-fixed);
  color: var(--on-secondary-fixed-variant);
}

/* 隐私承诺 */
.privacy {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: var(--surface-container);
}

/* 加载旋转 */
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.spin {
  display: inline-block;
  animation: spin 1s linear infinite;
}

.chat-page {
  padding-bottom: 340rpx;
}

/* 资料卡 */
.profile-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.prof-avatar-wrap {
  position: relative;
  flex-shrink: 0;
}
.prof-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--surface-container);
  color: var(--primary-container);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 600;
}
.prof-check {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--secondary);
  color: var(--on-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.15);
}
.prof-sub {
  margin-top: 4rpx;
}
.prof-badge {
  flex-shrink: 0;
}

/* 警告横幅 */
.warn {
  background: #ffdbd0;
  border-radius: 24rpx;
  padding: 16rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.warn-ico {
  color: var(--tertiary-container);
}
.warn-text {
  color: #3a0a00;
}

/* 上下文卡片 */
.context-card {
  margin-bottom: 24rpx;
}
.ctx-img-wrap {
  width: 112rpx;
  height: 112rpx;
  border-radius: 16rpx;
  background: var(--surface-container-high);
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
}
.ctx-img {
  width: 100%;
  height: 100%;
  border-radius: 0;
  font-size: 18rpx;
}
.ctx-tag {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 50, 75, 0.75);
  color: var(--on-primary);
  font-size: 18rpx;
  text-align: center;
  padding: 4rpx 0;
}
.ctx-line {
  margin-top: 4rpx;
}
.ctx-bottom {
  margin-top: 8rpx;
}

/* 消息流 */
.msg-list {
  gap: 24rpx;
}
.sys-msg {
  display: flex;
  justify-content: center;
  margin: 8rpx 0;
}
.sys-pill {
  background: var(--surface-low);
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  text-align: center;
  max-width: 85%;
}
.msg-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  max-width: 88%;
}
.msg-row-right {
  flex-direction: row-reverse;
  align-self: flex-end;
}
.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.msg-avatar-other {
  background: var(--surface-container);
  color: var(--primary-container);
}
.msg-avatar-me {
  background: var(--primary);
  color: var(--on-primary);
}
.msg-author {
  margin-left: 8rpx;
  margin-bottom: 8rpx;
}
.msg-col-right {
  align-items: flex-end;
}
.bubble {
  padding: 24rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--on-surface);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.06);
  word-break: break-all;
}
.bubble-other {
  background: var(--surface-lowest);
  border-top-left-radius: 8rpx;
}
.bubble-me {
  background: #95ec69;
  color: #111827;
  border: 1rpx solid #82e255;
  border-top-right-radius: 8rpx;
}

/* 协议达成卡片 */
.agree-card {
  background: var(--surface-container-high);
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin: 8rpx 0;
}
.agree-head {
  align-items: center;
}
.agree-body {
  color: var(--on-surface-variant);
}
.agree-loc {
  background: var(--surface-lowest);
  border-radius: 16rpx;
  padding: 16rpx;
  align-items: center;
}

/* 底部输入区 */
.chat-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  background: rgba(249, 249, 255, 0.95);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
  padding-bottom: env(safe-area-inset-bottom);
}
.quick-scroll {
  white-space: nowrap;
  padding: 12rpx 32rpx;
  box-sizing: border-box;
}
.quick-row {
  gap: 12rpx;
}
.quick-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--surface-container);
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 500;
  flex-shrink: 0;
}
.input-bar {
  gap: 12rpx;
  padding: 12rpx 32rpx;
}
.input-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--on-surface-variant);
  flex-shrink: 0;
}
.input-wrap {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  background: var(--surface-lowest);
  border-radius: 999rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  box-shadow: inset 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}
.chat-input {
  width: 100%;
  font-size: 28rpx;
  color: var(--on-surface);
}
.btn-send {
  height: 72rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: var(--on-primary);
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.tool-row {
  gap: 16rpx;
  padding: 8rpx 32rpx 16rpx;
}
.btn-tool {
  flex: 1;
  height: 72rpx;
  font-size: 22rpx;
  font-weight: 500;
  border-radius: 16rpx;
  gap: 8rpx;
}
.tool-neutral {
  background: var(--surface-low);
  color: var(--primary);
}
.tool-green {
  background: var(--secondary-container);
  color: var(--on-secondary-container);
}

<import src="../../templates/api-state.wxml"/><view class="page chat-page api-page"><template is="api-state" data="{{loading,error,needsLogin}}"/><button wx:if="{{hasMore}}" class="btn btn-outline" bindtap="older">查看更早消息</button><view wx:for="{{messages}}" wx:key="id" class="card col gap-xs"><text class="caption muted">{{item.kind === 'right' ? '我' : item.author}} · {{item.time}}</text><text class="body-sm api-content">{{item.text}}</text></view><text wx:if="{{!loading && !messages.length}}" class="api-empty">暂无消息，开始沟通吧</text><view class="card col gap-sm"><textarea class="api-form-textarea" value="{{inputValue}}" maxlength="2000" bindinput="onInput" placeholder="输入消息"/><button class="btn btn-primary" bindtap="send" disabled="{{busy || !inputValue || error}}" loading="{{busy}}">发送</button></view></view>

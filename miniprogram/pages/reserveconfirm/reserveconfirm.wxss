.reserveconfirm-page {
  padding-bottom: 260rpx;
}

.primary { color: #00324b; }
.green { color: #1a6b4a; }
.text-right { align-items: flex-end; }

/* 顶部步骤 */
.step-top { margin-bottom: 16rpx; }
.step-num {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #1b4965;
  color: #ffffff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.step-title { font-size: 26rpx; font-weight: 500; color: #00324b; }
.sandbox-pill {
  font-size: 20rpx;
  color: #41474d;
  background: #e7eeff;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

/* 声明横幅 */
.legal-banner {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  background: #ffdbd0;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.legal-icon { color: #5c1600; margin-top: 4rpx; }
.legal-title { font-size: 26rpx; font-weight: 600; color: #5c1600; }
.demo-pill {
  font-size: 20rpx;
  color: #5c1600;
  background: rgba(92, 22, 0, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}
.legal-text {
  font-size: 24rpx;
  color: #812909;
  line-height: 1.6;
  margin-top: 4rpx;
}

/* 视觉锚点横幅 */
.anchor-banner {
  height: 224rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #1b4965, #00324b);
  color: #ffffff;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-end;
  padding: 24rpx;
}
.anchor-caption {
  font-size: 20rpx;
  color: #8eb8d8;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}
.anchor-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-top: 4rpx;
}

/* 摘要卡片 */
.summary-card {
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.summary-head {
  padding-bottom: 8rpx;
}
.summary-head-title { font-size: 26rpx; font-weight: 600; color: #121c2c; }
.qualify-pill {
  font-size: 20rpx;
  color: #237150;
  background: #a5f3c9;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

.kv-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.kv-box {
  background: #f0f3ff;
  border-radius: 16rpx;
  padding: 16rpx;
  display: flex;
  flex-direction: column;
}
.kv-label { font-size: 20rpx; color: #41474d; margin-bottom: 4rpx; }
.kv-value { font-size: 34rpx; font-weight: 700; color: #00324b; }
.kv-baseline { align-items: baseline; gap: 8rpx; }
.kv-unit { font-size: 20rpx; color: #41474d; }
.kv-tags { margin-top: 8rpx; flex-wrap: wrap; }
.kv-tag {
  font-size: 20rpx;
  color: #41474d;
  background: #e7eeff;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}
.kv-date { font-size: 20rpx; color: #41474d; margin-top: auto; }

.schedule-row {
  background: #f0f3ff;
  border-radius: 16rpx;
  padding: 8rpx 16rpx;
}
.schedule-text { font-size: 24rpx; font-weight: 500; color: #121c2c; }
.buffer-pill {
  font-size: 20rpx;
  color: #41474d;
  background: #f9f9ff;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.identity-row {
  background: #f0f3ff;
  border-radius: 16rpx;
  padding: 16rpx;
}
.avatar-initial {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #1b4965;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.identity-name { font-size: 26rpx; font-weight: 600; color: #121c2c; }
.cert-pill {
  font-size: 20rpx;
  color: #41474d;
  background: #dee8ff;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
.identity-sub { font-size: 20rpx; color: #41474d; }
.credit-label { font-size: 20rpx; color: #41474d; }
.credit-value { font-size: 26rpx; font-weight: 700; color: #1a6b4a; }
.credit-total { font-size: 20rpx; color: #41474d; }

/* 契约 */
.covenant-card {
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.covenant-head { align-items: center; }
.covenant-title { font-size: 26rpx; font-weight: 600; color: #121c2c; }
.clause-badge {
  font-size: 20rpx;
  color: #41474d;
  background: #e7eeff;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-left: auto;
}

.clause {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  background: #f0f3ff;
  border-radius: 16rpx;
  padding: 16rpx;
}
.clause-num {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #00324b;
  color: #ffffff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.clause-title { font-size: 22rpx; font-weight: 600; color: #121c2c; }
.clause-text {
  font-size: 24rpx;
  color: #41474d;
  line-height: 1.6;
  margin-top: 4rpx;
}
.primary-strong { color: #00324b; font-weight: 500; }

.clause-alert { background: #ffdbd0; }
.clause-num-alert { background: #ba1a1a; color: #ffffff; }
.alert-title { color: #3a0a00; }
.alert-text { color: #812909; }
.alert-strong { color: #ba1a1a; font-weight: 700; }

/* 订阅与协议 */
.agree-section { margin-bottom: 24rpx; }
.notify-card { align-items: center; }
.notify-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: #a5f3c9;
  color: #237150;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.notify-title { font-size: 26rpx; font-weight: 600; color: #121c2c; }
.notify-sub { font-size: 20rpx; color: #41474d; }

.switch {
  width: 88rpx;
  height: 48rpx;
  border-radius: 999rpx;
  position: relative;
  padding: 4rpx;
  transition: background-color 0.2s;
  flex-shrink: 0;
}
.switch.on { background: #1a6b4a; }
.switch.off { background: #c1c7ce; }
.switch-thumb {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.2);
  transition: transform 0.2s;
}
.switch-thumb.on { transform: translateX(40rpx); }
.switch-thumb.off { transform: translateX(0); }

.agree-card { align-items: flex-start; gap: 16rpx; }
.agree-box {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  background: #e7eeff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.agree-box.checked { background: #00324b; }
.check-mark { color: #ffffff; font-size: 32rpx; font-weight: 700; line-height: 1; }
.agree-text { font-size: 24rpx; color: #121c2c; line-height: 1.5; flex: 1; }
.agree-link {
  color: #00324b;
  font-weight: 500;
  text-decoration: underline;
}

/* 微卡片 */
.micro-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(222, 232, 255, 0.6);
  border-radius: 16rpx;
  padding: 16rpx;
  color: #41474d;
}
.micro-text { font-size: 20rpx; }
.micro-tls { font-size: 20rpx; color: #00324b; font-weight: 600; }

/* 底部操作栏 */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  background: rgba(255, 255, 255, 0.95);
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}
.fee-label { font-size: 20rpx; color: #41474d; }
.fee-value { font-size: 34rpx; font-weight: 700; color: #1a6b4a; }
.fee-unit { font-size: 20rpx; color: #1a6b4a; font-weight: 500; }

.submit-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  background: #3a7294;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 50, 75, 0.2);
}
.submit-btn.done { background: #1a6b4a; }
.spinner { animation: spin 1s linear infinite; }
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 反馈提示 */
.feedback-toast {
  position: fixed;
  top: 160rpx;
  left: 50%;
  transform: translateX(-50%) translateY(-8rpx);
  background: #00324b;
  color: #ffffff;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  display: flex;
  align-items: center;
  gap: 8rpx;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s, transform 0.3s;
  z-index: 50;
}
.feedback-toast.show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}
.feedback-text { font-size: 22rpx; font-weight: 500; }

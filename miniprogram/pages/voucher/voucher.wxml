<import src="../../templates/api-state.wxml"/><view class="page api-page"><template is="api-state" data="{{loading,error,needsLogin}}"/><view wx:if="{{reservation}}" class="card col gap-md"><text class="headline-sm">{{reservation.resource.name}}</text><view class="badge badge-primary">{{reservation.statusLabel}}</view><text>{{reservation.slot.slotDate}} {{reservation.slot.startTime}} — {{reservation.slot.endTime}}</text><text>座位 / 名额：{{reservation.seatNo === 0 ? '整间 / 整台' : reservation.seatNo}}</text><text class="caption muted">预约编号：{{reservation.id}}</text><text wx:if="{{reservation.pendingExpiresAt}}" class="caption muted">待确认有效期：{{reservation.pendingExpiresText}}</text><text class="api-source">{{reservation.sourceName}}</text><button class="btn btn-outline" bindtap="copyCode">复制预约编号</button><button wx:if="{{reservation.status === 'confirmed'}}" class="btn btn-primary" bindtap="checkIn" disabled="{{busy}}">扫描现场凭证签到</button><button wx:if="{{reservation.status === 'pending' || reservation.status === 'confirmed'}}" class="btn btn-outline" bindtap="cancelReservation" disabled="{{busy}}">取消预约</button></view></view>

<import src="../../templates/api-state.wxml"/><view class="page api-page"><template is="api-state" data="{{loading,error,needsLogin}}"/><view class="card col gap-sm"><text class="headline-sm">选择场地与日期</text><picker mode="date" value="{{date}}" bindchange="selectDate"><view class="api-picker">预约日期：{{date}} ›</view></picker><view class="api-actions"><button wx:for="{{resources}}" wx:key="id" class="btn {{resource.id === item.id ? 'btn-primary' : 'btn-outline'}} btn-xs" data-id="{{item.id}}" bindtap="selectResource">{{item.name}}</button></view></view><view class="card col gap-sm"><text class="headline-sm">{{resource.name || '暂无可预约资源'}}</text><text class="api-source">{{resource.sourceName}} {{resource.isStale ? '· 来源已过期' : ''}}</text><view wx:for="{{slots}}" wx:key="id" class="well col gap-sm"><text class="label-md">{{item.startTime}} — {{item.endTime}}</text><text class="caption muted">剩余 {{item.remaining}} · {{item.statusLabel}}</text><button class="btn btn-primary btn-sm" data-id="{{item.id}}" bindtap="goSeat" disabled="{{item.status !== 'available' || item.remaining === 0}}">选择座位 / 使用名额</button></view><text wx:if="{{!loading && !slots.length}}" class="api-empty">该日期暂无开放时段，请选择其他日期</text></view></view>

<import src="../../templates/api-state.wxml"/><view class="page api-page"><template is="api-state" data="{{loading,error,needsLogin}}"/><view wx:for="{{notifications}}" wx:key="id" class="card col gap-sm" data-index="{{index}}" bindtap="readNotification"><view class="api-heading"><text class="label-md">{{item.title}}</text><text class="caption muted">{{item.readAt ? '已读' : '未读'}}</text></view><text class="body-sm muted">{{item.content}}</text></view><view wx:for="{{entries}}" wx:key="id" class="card col gap-sm" data-index="{{index}}" bindtap="open"><text class="headline-sm">{{item.titleText}}</text><text class="body-sm muted">{{item.subtitle}}</text><text class="caption muted">{{item.dateText}}</text></view><text wx:if="{{!loading && !entries.length && !notifications.length}}" class="api-empty">暂无记录</text><button wx:if="{{hasMore}}" class="btn btn-outline" bindtap="onReachBottom">加载更多</button></view>

.page.pg {
  padding-bottom: calc(128px + env(safe-area-inset-bottom));
}

.pg { gap: 28rpx; }

/* 搜索框（Uiverse 样例：深色圆角外框 + 白色胶囊按钮，px 已按 2 倍换算 rpx） */
.search-box {
  width: fit-content;
  max-width: 100%;
  height: 90rpx; /* 样例 45px */
  border-radius: 40rpx; /* 样例 20px */
  padding: 10rpx; /* 样例 5px */
  box-sizing: content-box;
  display: flex;
  align-items: center;
  background-color: #292524;
}
.search-box .ico {
  font-size: 60rpx; /* 样例图标 30px */
  margin-left: 16rpx; /* 样例 8px */
  transition: all 0.3s;
}
.search-hover { background-color: #292524; }
.search-hover .ico { transform: scale(1.3); } /* 样例 input-wrapper:active .icon */
.search-input {
  width: 340rpx; /* 样例 max-width 170px */
  max-width: 340rpx;
  height: 100%;
  border: none;
  outline: none;
  padding-left: 30rpx; /* 样例 15px */
  background-color: #292524;
  color: #ffffff;
  font-size: 28rpx; /* 样例 1em */
}
.search-box .placeholder { color: rgba(255, 255, 255, 0.5); }
.search-btn {
  height: 100%;
  width: 190rpx; /* 样例 95px */
  border: none;
  border-radius: 30rpx; /* 样例 15px */
  color: rgb(0, 0, 0);
  background-color: #ffffff;
  font-weight: 500;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: all 0.3s;
  margin: 0;
  padding: 0;
  font-size: 26rpx;
  line-height: 1.4;
  flex-shrink: 0;
}
.search-btn::after { border: none; }
.search-btn .arrow {
  position: absolute;
  margin-right: 300rpx; /* 样例 150px */
  color: rgb(0, 0, 0);
  transition: all 0.3s;
}
/* 样例 :hover 改为小程序 hover-class（按压态） */
.search-btn-hover {
  color: #ffffff;
  background-color: #ffffff;
  transform: scale(0.9);
}
.search-btn-hover .arrow {
  margin-right: 0;
  animation: jello-vertical 0.9s both;
  transform-origin: right;
}
@keyframes jello-vertical {
  0% { transform: scale3d(1, 1, 1); }
  30% { transform: scale3d(0.75, 1.25, 1); }
  40% { transform: scale3d(1.25, 0.75, 1); }
  50% { transform: scale3d(0.85, 1.15, 1); }
  65% { transform: scale3d(1.05, 0.95, 1); }
  75% { transform: scale3d(0.95, 1.05, 1); }
  100% { transform: scale3d(1, 1, 1); }
}
/* 小屏收窄，避免溢出 */
@media (max-width: 360px) {
  .search-input { width: 220rpx; max-width: 220rpx; }
  .search-btn { width: 170rpx; }
}

/* 分类标签 */
.cat-scroll {
  width: 100%;
  height: 52px;
  margin-top: 8rpx;
  margin-bottom: 12rpx;
  box-sizing: border-box;
  white-space: nowrap;
}
.cat-row {
  display: flex;
  width: 100%;
  gap: 8rpx;
  box-sizing: border-box;
}
.page .cat-row > button.cat-btn {
  flex: 1 1 0%;
  width: 0;
  min-width: 0;
  height: 44px;
  min-height: 44px;
  margin: 0;
  padding: 0 2px;
  box-sizing: border-box;
  border: 0;
  border-radius: 999rpx;
  font-family: inherit;
  font-weight: 500;
  line-height: 1;
  white-space: nowrap;
  text-align: center;
  display: inline-flex;
  justify-content: center;
  align-items: center;
}
.page .cat-row > button.cat-btn.cat-short { font-size: 26rpx; }
.page .cat-row > button.cat-btn.cat-long { font-size: 22rpx; }
.cat-btn::after { border: none; }
.page .cat-row > button.cat-btn.cat-on {
  color: #1b4965;
  box-shadow: inset 0 5rpx 12rpx rgba(27, 49, 71, 0.16),
    inset 0 -2rpx 5rpx rgba(255, 255, 255, 0.8);
}
.page .cat-row > button.cat-btn.cat-off { color: #4a5568; }

/* 画像匹配 */
.match-chip {
  background: var(--surface-container);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
}

/* 徽章补充 */
.badge-cross { background: #ffdbd0; color: #812909; }

/* 材料清单 */
.checklist {
  border: 1rpx solid rgba(193, 199, 206, 0.6);
  border-radius: 8rpx;
  overflow: hidden;
  background: var(--surface-container-lowest);
}
.check-row { padding: 12rpx 20rpx; }
.check-row + .check-row { border-top: 1rpx solid rgba(193, 199, 206, 0.4); }
.check-row-last { background: rgba(240, 243, 255, 0.6); }

/* 文字按钮 */
.link-btn { background: transparent; border: none; padding: 0; line-height: 1; }
.link-btn::after { border: none; }

.card3-foot { border-top: 1rpx solid rgba(193, 199, 206, 0.4); padding-top: 16rpx; }

.disclaimer {
  background: var(--surface-container-low);
  border-radius: 20rpx;
  padding: 20rpx;
  gap: 12rpx;
  align-items: flex-start;
}

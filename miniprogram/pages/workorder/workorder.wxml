<import src="../../templates/api-state.wxml"/><view class="page api-page"><template is="api-state" data="{{loading,error,needsLogin}}"/><view wx:if="{{detail}}" class="card col gap-md"><text class="headline-sm">{{detail.description}}</text><text>{{detail.location}} · {{detail.statusLabel}}</text><text class="body-sm muted">处理人：{{detail.assigneeDisplayName || '暂未分配'}}</text><view wx:for="{{detail.events}}" wx:key="id" class="well col gap-xs"><text>{{item.toStatus}} · {{item.operatorDisplayName}}</text><text class="body-sm muted">{{item.comment}}</text></view><block wx:if="{{detail.status === 'completed' || detail.serviceStage === 'awaiting_rating'}}"><picker range="{{[1,2,3,4,5]}}" bindchange="rate"><view class="api-picker">服务评分：{{score}} 星</view></picker><textarea class="api-form-textarea" placeholder="评价（可选）" data-field="comment" bindinput="input" maxlength="512"/><button class="btn btn-primary" bindtap="submitRating" disabled="{{busy}}">提交评价</button></block></view><view wx:else class="card col gap-md"><text class="headline-sm">{{category === 'facility' ? '公共设施报修' : '宿舍报修'}}</text><text class="api-form-label">故障位置</text><input class="api-form-input" value="{{location}}" data-field="location" bindinput="input" maxlength="255" placeholder="楼栋、房间或设施名称"/><text class="api-form-label">问题描述</text><textarea class="api-form-textarea" value="{{description}}" data-field="description" bindinput="input" maxlength="1024" placeholder="请描述具体故障"/><view class="api-heading"><text>紧急处理</text><switch checked="{{urgency === 'urgent'}}" bindchange="toggleUrgency"/></view><view class="api-images"><image wx:for="{{images}}" wx:key="id" class="api-image" src="{{item.path}}"/></view><button class="btn btn-outline" bindtap="addImage" disabled="{{busy}}">添加现场图片</button><button class="btn btn-primary" bindtap="submit" disabled="{{busy}}" loading="{{busy}}">提交报修</button></view></view>

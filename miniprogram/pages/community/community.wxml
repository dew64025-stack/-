<import src="../../templates/api-state.wxml"/><view class="page api-page"><template is="api-state" data="{{loading,error,needsLogin}}"/><block wx:if="{{detail}}"><view class="card col gap-md"><text class="headline-sm">{{detail.title}}</text><text class="caption muted">{{detail.pseudonym}} · {{detail.statusLabel}}</text><text class="body-sm api-content">{{detail.content}}</text><button wx:if="{{detail.canEdit}}" class="btn btn-outline" bindtap="remove">删除本人帖子</button></view><view wx:for="{{comments}}" wx:key="id" class="card col gap-xs"><text class="caption muted">{{item.pseudonym}} · {{item.dateText}}</text><text class="body-sm api-content">{{item.content}}</text><button wx:if="{{item.canDelete}}" class="link-btn" bindtap="removeComment" data-id="{{item.id}}">删除回复</button></view><view class="card col gap-sm"><textarea class="api-form-textarea" maxlength="2048" value="{{reply}}" bindinput="input" placeholder="尊重、友善地交流"/><button class="btn btn-primary" bindtap="comment" disabled="{{busy}}">提交回复</button></view></block><block wx:else><button class="btn btn-primary" bindtap="create">发布匿名交流</button><view wx:for="{{entries}}" wx:key="id" class="card col gap-sm" data-id="{{item.id}}" bindtap="open"><text class="headline-sm">{{item.title}}</text><text class="caption muted">{{item.pseudonym}}</text><text class="body-sm muted">{{item.content}}</text></view><text wx:if="{{!loading && !entries.length}}" class="api-empty">暂无公开交流帖</text><button wx:if="{{hasMore}}" class="btn btn-outline" bindtap="onReachBottom">加载更多</button></block></view>

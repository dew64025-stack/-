.settings-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}
.settings-intro {
  padding: 8rpx 4rpx;
}
.settings-section-title {
  padding: 4rpx 12rpx 8rpx;
}
.settings-row {
  display: flex;
  width: 100%;
  min-height: 96rpx;
  padding: 16rpx;
  border: none;
  border-radius: 16rpx;
  background: var(--surface-container-low);
  text-align: left;
  line-height: 1.45;
}
.settings-row::after {
  border: none;
}
.settings-row:active {
  opacity: 0.82;
}
.settings-row .col {
  min-width: 0;
  gap: 4rpx;
}
.settings-danger {
  background: #fff1f0;
}
.settings-notice {
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: var(--surface-container-low);
}

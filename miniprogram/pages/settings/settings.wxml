<import src="../../templates/api-state.wxml"/>
<view class="page api-page settings-page">
  <view class="settings-intro col gap-xs"><text class="headline-sm primary-text">隐私、授权与数据权利</text><text class="body-sm muted">自主控制授权、个人数据与账号状态</text></view>
  <template is="api-state" data="{{loading,error,needsLogin}}"/>
  <view wx:if="{{!error}}" class="card col gap-sm"><text class="label-md">隐私偏好</text><view class="api-heading"><text class="body-sm">个性化推荐</text><switch checked="{{privacy.personalization}}" data-field="personalization" bindchange="changePrivacy" disabled="{{busy}}"/></view><view class="api-heading"><text class="body-sm">记录浏览历史</text><switch checked="{{privacy.historyEnabled}}" data-field="historyEnabled" bindchange="changePrivacy" disabled="{{busy}}"/></view><view class="api-heading"><text class="body-sm">附近信息</text><switch checked="{{privacy.nearbyEnabled}}" data-field="nearbyEnabled" bindchange="changePrivacy" disabled="{{busy}}"/></view></view>
  <view class="card col gap-sm"><text class="label-md">授权记录与撤回</text><view wx:for="{{authorizations}}" wx:key="id" class="well col gap-sm"><view class="api-heading"><text>{{item.typeLabel}}</text><text class="caption muted">{{item.statusLabel}}</text></view><text class="caption muted">{{item.scope}}</text><button wx:if="{{item.status === 'granted'}}" class="btn btn-outline btn-xs" data-id="{{item.id}}" bindtap="revoke" disabled="{{busy}}">撤回授权</button></view><text wx:if="{{!loading && !authorizations.length}}" class="api-empty">暂无授权记录</text></view>
  <view class="card col gap-sm"><text class="label-md">数据与账号</text><button class="settings-row" bindtap="exportData" disabled="{{busy || needsLogin}}">申请导出个人数据</button><button class="settings-row settings-danger error-text" bindtap="deleteAccount" disabled="{{busy || needsLogin}}">申请注销账号</button></view>
  <view class="card col gap-sm"><text class="label-md">我的数据申请</text><view wx:for="{{requests}}" wx:key="id" class="well col gap-xs"><text class="label-md">{{item.type === 'deletion' ? '账号注销' : '个人数据导出'}} · {{item.statusLabel}}</text><text class="caption muted">申请时间：{{item.dateText}}</text><text wx:if="{{item.coolingOffUntil}}" class="caption muted">冷静期截至：{{item.untilText}}</text><view class="api-actions"><button class="btn btn-outline btn-xs" bindtap="requestDetail" data-id="{{item.id}}" disabled="{{busy}}">查看结果 / 下载</button><button wx:if="{{item.canCancel}}" class="btn btn-outline btn-xs" bindtap="cancelRequest" data-id="{{item.id}}" disabled="{{busy}}">撤销申请</button></view></view><text wx:if="{{!requests.length}}" class="api-empty">暂无数据申请</text></view>
  <button class="btn btn-outline" bindtap="logout" disabled="{{busy || needsLogin}}">退出登录</button>
</view>

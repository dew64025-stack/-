.page.pg {
  padding-bottom: calc(128px + env(safe-area-inset-bottom));
}

.pg { gap: 28rpx; }

/* 安全合规提示 */
.safety-tip {
  background: #ffdbd0;
  color: #3a0a00;
  border-radius: 16rpx;
  padding: 16rpx;
  gap: 8rpx;
  align-items: flex-start;
}
.safety-ico { font-size: 36rpx; margin-top: 4rpx; flex-shrink: 0; }
.safety-text { font-size: 24rpx; line-height: 1.5; flex: 1; }

/* 搜索与发帖 */
.search-row {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  gap: 16rpx;
  width: 100%;
  min-width: 0;
}
.search-box {
  width: fit-content;
  max-width: 100%;
  height: 90rpx; /* 样例 45px */
  border-radius: 40rpx; /* 样例 20px */
  padding: 10rpx; /* 样例 5px */
  box-sizing: content-box;
  display: flex;
  align-items: center;
  background-color: #292524;
}
.search-box .ico {
  font-size: 60rpx; /* 样例图标 30px */
  margin-left: 16rpx; /* 样例 8px */
  transition: all 0.3s;
}
.search-hover { background-color: #292524; }
.search-hover .ico { transform: scale(1.3); } /* 样例 input-wrapper:active .icon */
.search-input {
  width: 340rpx; /* 样例 max-width 170px */
  max-width: 340rpx;
  height: 100%;
  border: none;
  outline: none;
  padding-left: 30rpx; /* 样例 15px */
  background-color: #292524;
  color: #ffffff;
  font-size: 28rpx; /* 样例 1em */
}
.search-box .placeholder { color: rgba(255, 255, 255, 0.5); }
.publish-btn {
  flex: 0 0 auto;
  height: 100%;
  width: 190rpx; /* 样例 95px */
  border: none;
  border-radius: 30rpx; /* 样例 15px */
  color: rgb(0, 0, 0);
  background-color: #ffffff;
  font-weight: 500;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: all 0.3s;
  margin: 0;
  padding: 0;
  font-size: 26rpx;
  white-space: nowrap;
  line-height: 1.4;
  flex-shrink: 0;
}
.publish-btn::after { border: none; }
.publish-btn .arrow {
  position: absolute;
  margin-right: 300rpx; /* 样例 150px */
  color: rgb(0, 0, 0);
  transition: all 0.3s;
}
/* 样例 :hover 改为小程序 hover-class（按压态） */
.btn-hover {
  color: #ffffff;
  background-color: #ffffff;
  transform: scale(0.9);
}
.btn-hover .arrow {
  margin-right: 0;
  animation: jello-vertical 0.9s both;
  transform-origin: right;
}
@keyframes jello-vertical {
  0% { transform: scale3d(1, 1, 1); }
  30% { transform: scale3d(0.75, 1.25, 1); }
  40% { transform: scale3d(1.25, 0.75, 1); }
  50% { transform: scale3d(0.85, 1.15, 1); }
  65% { transform: scale3d(1.05, 0.95, 1); }
  75% { transform: scale3d(0.95, 1.05, 1); }
  100% { transform: scale3d(1, 1, 1); }
}

/* 分类标签 */
.cat-scroll {
  width: 100%;
  height: calc(44px + 24rpx);
  box-sizing: border-box;
  white-space: nowrap;
  border-bottom: 1rpx solid rgba(193, 199, 206, 0.4);
  padding-bottom: 16rpx;
  margin-top: 8rpx;
}
.cat-row {
  display: inline-flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: center;
  min-width: 100%;
  gap: 8rpx;
}
.cat-btn {
  flex: 0 0 auto;
  min-width: 0;
  margin: 0;
  white-space: nowrap;
  line-height: 1.4;
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  display: inline-flex;
  align-items: center;
}
.cat-btn::after { border: none; }
.page .cat-btn.cat-on {
  background: var(--primary);
  color: var(--on-primary);
  box-shadow: inset 0 5rpx 12rpx rgba(0, 25, 40, 0.28),
    inset 0 -2rpx 5rpx rgba(255, 255, 255, 0.32),
    0 5rpx 10rpx rgba(0, 50, 75, 0.18);
}
.page .cat-btn.cat-off {
  background: linear-gradient(145deg, #f8fafc, #e4e9f0);
  color: var(--on-surface-variant);
}

/* 徽章补充 */
.badge-lost { background: #c9e6ff; color: #001e2f; }
.badge-team { background: var(--primary-container); color: var(--on-primary-container); }

/* 卡片 */
.card-img { width: 160rpx; height: 160rpx; }
.card-img-tall { width: 160rpx; height: 192rpx; }
.card-side { gap: 12rpx; }
.handoff { background: var(--surface-container-low); border-radius: 8rpx; padding: 8rpx 12rpx; }
.wide-img-wrap { position: relative; }
.wide-img { height: 224rpx; }
.wide-overlay { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
.overlay-pill {
  background: var(--surface-container-lowest);
  color: var(--on-surface);
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.card3-foot {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  border-top: 1rpx solid rgba(193, 199, 206, 0.4);
  padding-top: 16rpx;
}
.card3-foot > text {
  flex: 1 1 auto;
  min-width: 0;
  white-space: nowrap;
  font-size: 22rpx;
  line-height: 1.4;
}
.card3-foot > .row {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  flex: 0 0 auto;
  align-items: center;
  gap: 8rpx;
}
.card3-foot .btn {
  display: inline-flex;
  flex-direction: row;
  flex-wrap: nowrap;
  flex: 0 0 auto;
  margin: 0;
  min-height: 44px;
  padding: 12rpx 16rpx;
  white-space: nowrap;
  line-height: 1.4;
}
.card3-foot .btn text {
  white-space: nowrap;
}
@media (max-width: 360px) {
  .search-input { width: 220rpx; max-width: 220rpx; }
  .publish-btn { width: 170rpx; }
  .cat-btn { padding-left: 18rpx; padding-right: 18rpx; }
  .card3-foot { gap: 8rpx; }
  .card3-foot .btn { padding-left: 12rpx; padding-right: 12rpx; }
}
.avatar-sm { width: 56rpx; height: 56rpx; font-size: 22rpx; }

.foot { padding: 16rpx 0 24rpx; }

<import src="../../templates/api-state.wxml"/>
<view class="page verify-page api-page">
  <template is="api-state" data="{{loading,error,needsLogin}}"/>
  <view class="card col gap-md"><text class="headline-sm primary-text">学生身份认证</text><text class="body-sm muted">请填写本人学号，提交后等待学校或管理员核验。</text><view wx:if="{{verification}}" class="well col gap-sm"><text>当前状态：{{verification.statusLabel}}</text><text>{{verification.studentNumberMasked}}</text><text wx:if="{{verification.id}}" class="caption muted api-content">申请编号：{{verification.id}}</text><text wx:if="{{verification.status === 'pending'}}" class="caption muted">人工核验时可向学校审核人员出示申请编号，请勿发送密码或验证码。</text><text wx:if="{{verification.rejectReason}}" class="error-text">{{verification.rejectReason}}</text></view><text wx:else class="body-sm muted">尚未提交认证申请</text></view>
  <view class="card col gap-md"><text class="api-form-label">安全绑定手机</text><text>{{user.phoneMasked || '未绑定'}}</text><button wx:if="{{!user.phoneBound}}" class="btn btn-outline" bindtap="goPhone">先绑定手机号</button><text class="api-form-label">本人学号</text><input class="api-form-input" maxlength="32" value="{{studentId}}" bindinput="onStudentIdInput" placeholder="请输入完整学号"/><checkbox-group bindchange="onAgreeChange"><label class="row gap-sm"><checkbox value="agree" checked="{{agreed}}"/><text class="body-sm">我确认填写的信息属于本人且真实有效</text></label></checkbox-group><button class="btn btn-primary" disabled="{{busy || !user.phoneBound}}" loading="{{busy}}" bindtap="handlePostVerify">提交认证申请</button></view>
  <button class="btn btn-outline" bindtap="handleSkipVerify">稍后认证</button>
</view>

.page.pg {
  padding-bottom: calc(128px + env(safe-area-inset-bottom));
}

.pg { gap: 28rpx; }

/* AI 助手（搜索样例适配：白色胶囊外框 + 右侧蓝色胶囊按钮，px 已按 2 倍换算 rpx） */
.ai-box {
  position: relative;
  background: var(--surface-container-lowest);
  border-radius: 40rpx; /* 样例 20px */
  padding: 12rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 0 20rpx rgba(0, 0, 0, 0.1); /* 样例 0 0 10px rgba(0,0,0,0.1) */
}
.ai-box .ico { color: var(--outline); font-size: 36rpx; margin-left: 8rpx; }
/* 样例 input - 后者代码：透明底，圆角与阴影移到外框 */
.ai-input {
  flex: 1;
  background: #ffffff;
  font-size: 24rpx;
  height: 64rpx;
  box-sizing: border-box;
  min-width: 0;
  max-width: 100%;
  padding-right: 150rpx; /* 给右侧悬浮按钮让位 */
}
.ai-submit {
  position: absolute; /* 样例 position: absolute; top: 0; right: 0 */
  top: 0;
  bottom: 0; /* 高度贴合外框（样例只写 top: 0; right: 0） */
  right: 0;
  background-color: #4e99e9; /* 样例 */
  color: #fff; /* 样例 */
  border-radius: 40rpx; /* 样例 20px */
  padding: 0 40rpx; /* 样例 10px 20px */
  box-shadow: 0 0 20rpx rgba(0, 0, 0, 0.1); /* 样例 */
  transition: 0.9s ease; /* 样例 .9s ease */
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.ai-submit::after { border: none; }
/* 样例 :hover 改为小程序 hover-class（按压态） */
.ai-submit-hover {
  transform: scale(1.1);
  color: rgb(255, 255, 255);
  background-color: blue;
}

.quick-pills { gap: 12rpx; }
.quick-pill {
  background: var(--surface-container-low);
  color: var(--on-surface-variant);
  font-size: 25rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

/* 独立AI入口：与内容区同宽，不覆盖全局搜索及其他页面按钮。 */
.assistant-section { width: 100%; min-width: 0; }
.page button.assistant-banner {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 20rpx;
  width: 100%;
  min-height: 128rpx;
  margin: 0;
  padding: 24rpx;
  border: 1rpx solid var(--outline-variant);
  border-radius: 24rpx;
  background: var(--surface-container);
  color: var(--primary);
  text-align: left;
  line-height: 1.5;
  box-shadow: 0 12rpx 24rpx -8rpx rgba(0, 50, 75, 0.24),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.9);
  transition: background-color 180ms ease, box-shadow 180ms ease;
}
.page button.assistant-banner::after { border: 0; }
.assistant-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: var(--surface-lowest);
  color: var(--primary);
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 10rpx rgba(0, 50, 75, 0.1);
}
.assistant-heading { flex: 1; min-width: 0; gap: 4rpx; }
.assistant-title { font-size: 30rpx; font-weight: 700; }
.assistant-subtitle { font-size: 24rpx; font-weight: 400; color: var(--on-surface-variant); }
.assistant-entry-action { flex-shrink: 0; font-size: 24rpx; white-space: nowrap; }
.assistant-chevron { margin-left: 8rpx; font-size: 30rpx; }
.page button.assistant-banner.assistant-banner-pressed {
  transform: none;
  background: var(--surface-container-high);
  box-shadow: inset 0 4rpx 10rpx rgba(0, 50, 75, 0.12);
}
.assistant-panel {
  margin-top: 16rpx;
  padding: 24rpx;
  border: 1rpx solid var(--outline-variant);
  border-radius: 24rpx;
  background: var(--surface-lowest);
}
.assistant-label { font-size: 28rpx; font-weight: 600; }
.page textarea.assistant-question {
  display: block;
  width: 100%;
  height: 176rpx;
  min-height: 132rpx;
  margin: 0;
  padding: 20rpx;
  border: 1rpx solid var(--outline-variant);
  border-radius: 16rpx;
  background: var(--surface);
  color: var(--on-surface);
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}
.assistant-placeholder { color: var(--on-surface-variant); }
.assistant-note { font-size: 24rpx; color: var(--on-surface-variant); overflow-wrap: break-word; }
.assistant-error { font-size: 26rpx; color: var(--error); }
.assistant-status { font-size: 26rpx; color: var(--primary); }
.page button.assistant-send { width: 100%; min-height: 48px; padding: 20rpx 24rpx; font-size: 28rpx; }
.page button.assistant-send.assistant-send-pressed { transform: none; opacity: 0.85; }
.assistant-answer { padding-top: 20rpx; border-top: 1rpx solid var(--outline-variant); }
@media (max-width: 360px) {
  .page button.assistant-banner { gap: 16rpx; padding: 24rpx 20rpx; }
  .assistant-mark { flex-basis: 64rpx; width: 64rpx; height: 64rpx; }
}
@media (prefers-reduced-motion: reduce) {
  .page button.assistant-banner, .page button.assistant-send { transition: none; }
}

/* 分区标题 */
.sec-head { padding: 4rpx 8rpx; }
.sec-bar { width: 6rpx; height: 28rpx; border-radius: 999rpx; }
.sec-bar-primary { background: var(--primary); }
.sec-bar-secondary { background: var(--secondary); }
.sec-bar-outline { background: var(--outline); }

/* 徽章补充 */
.badge-scholar { background: #ffdbd0; color: #5c1600; }
.badge-deadline { background: rgba(255, 218, 214, 0.6); color: #7f2708; }
.badge-sign { background: var(--secondary-fixed); color: #002113; }
.badge-handling { background: #c9e6ff; color: var(--primary); }
.badge-public { background: var(--surface-container); color: var(--outline); }
.badge-zone { background: var(--surface-container); color: var(--primary); gap: 4rpx; }

/* 截止事项 */
.dl-foot {
  background: rgba(240, 243, 255, 0.5);
  border-radius: 16rpx;
  padding: 12rpx 16rpx;
}
.seat-actions { justify-content: flex-end; gap: 16rpx; margin-top: 8rpx; }

.link-btn { background: transparent; border: none; padding: 0; line-height: 1; }
.link-btn::after { border: none; }

/* 机会匹配 */
.match-rate { align-items: flex-end; gap: 4rpx; flex-shrink: 0; }
.rate-badge { gap: 4rpx; }

.avatars { gap: 0; }
.avatar-mini {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--surface-container);
  color: var(--on-surface);
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: -12rpx;
  border: 2rpx solid var(--surface-container-lowest);
}
.avatar-mini:first-child { margin-left: 0; }
.avatar-mini-green { background: var(--secondary-fixed); color: var(--secondary); }
.avatar-mini-blue { background: var(--surface-container-high); }

/* 互助快报 */
.mutual-ico { background: var(--surface-container); color: var(--primary); }
.mutual-ico-tertiary { color: var(--tertiary-container); }
.price-col { align-items: flex-end; gap: 4rpx; flex-shrink: 0; }

.foot { padding: 16rpx 0 24rpx; }

<import src="../../templates/api-state.wxml"/><view class="page api-page"><template is="api-state" data="{{loading,error,needsLogin}}"/><view class="card col gap-md"><text class="headline-sm">发布校园互助</text><picker range="{{categories}}" value="{{categoryIndex}}" data-field="categoryIndex" bindchange="picker"><view class="api-picker">分类：{{categories[categoryIndex]}}</view></picker><input class="api-form-input" value="{{titleText}}" data-field="titleText" bindinput="input" maxlength="256" placeholder="标题"/><textarea class="api-form-textarea" value="{{descText}}" data-field="descText" bindinput="input" maxlength="{{categoryIndex === 5 ? 5000 : 2048}}" placeholder="具体说明"/><block wx:if="{{categoryIndex !== 5}}"><input wx:if="{{categoryIndex !== 1 && categoryIndex !== 4}}" class="api-form-input" value="{{itemType}}" data-field="itemType" bindinput="input" placeholder="物品名称、教材名或物品类型"/><picker wx:if="{{categoryIndex === 0 || categoryIndex === 1}}" range="{{categoryIndex === 0 ? ['可出借','求借'] : ['丢失物品','拾到物品']}}" data-field="kindIndex" bindchange="picker"><view class="api-picker">{{categoryIndex === 0 ? (kindIndex === 0 ? '可出借' : '求借') : (kindIndex === 0 ? '丢失' : '拾到')}}</view></picker><view wx:if="{{categoryIndex === 1}}" class="api-actions"><picker mode="date" value="{{occurredDate}}" data-field="occurredDate" bindchange="date"><view class="api-picker">{{occurredDate}}</view></picker><picker mode="time" value="{{occurredTime}}" data-field="occurredTime" bindchange="date"><view class="api-picker">{{occurredTime}}</view></picker></view><input class="api-form-input" value="{{exchangeArea}}" data-field="exchangeArea" bindinput="input" maxlength="128" placeholder="{{categoryIndex === 1 ? '丢失或拾到地点（必填）' : '交接区域'}}"/><block wx:if="{{categoryIndex === 2 || categoryIndex === 3}}"><picker range="{{conditions}}" value="{{conditionIndex}}" data-field="conditionIndex" bindchange="picker"><view class="api-picker">品相：{{conditions[conditionIndex]}}</view></picker><input class="api-form-input" value="{{price}}" data-field="price" bindinput="input" type="digit" placeholder="线下价格（可选，无线上支付）"/></block><block wx:if="{{categoryIndex === 4}}"><input class="api-form-input" value="{{offeredSkills}}" data-field="offeredSkills" bindinput="input" placeholder="可提供技能（用逗号分隔）"/><input class="api-form-input" value="{{wantedSkills}}" data-field="wantedSkills" bindinput="input" placeholder="希望交换技能（用逗号分隔）"/></block><view class="api-images"><view wx:for="{{images}}" wx:key="id" data-id="{{item.id}}" bindtap="removePhoto"><image class="api-image" src="{{item.path}}"/><text class="caption muted">点击移除</text></view></view><button class="btn btn-outline" bindtap="addPhoto" disabled="{{busy}}">上传图片</button></block><text wx:else class="body-sm muted">匿名身份由服务器生成，公开页面不展示真实账号信息。</text><checkbox-group bindchange="agree"><label class="row gap-sm"><checkbox value="agree" checked="{{agreed}}"/><text class="body-sm">同意校园互助规则并保证发布内容真实</text></label></checkbox-group><view class="api-actions"><button class="btn btn-outline" bindtap="saveDraftToast">本机草稿</button><button class="btn btn-primary" bindtap="submitPostToast" disabled="{{busy}}" loading="{{busy}}">提交发布</button></view></view></view>

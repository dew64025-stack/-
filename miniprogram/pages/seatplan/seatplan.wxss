.seatplan-page {
  padding-bottom: 60rpx;
}

/* 顶部场馆信息 */
.seat-head {
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.head-name { font-size: 34rpx; font-weight: 700; color: #121c2c; }
.head-sub { font-size: 24rpx; color: #41474d; margin-top: 4rpx; }
.area-pill {
  font-size: 22rpx;
  font-weight: 500;
  color: #065f46;
  background: #ecfdf5;
  border: 1rpx solid #a7f3d0;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}
.sync-pill {
  font-size: 22rpx;
  color: #047857;
  background: #ecfdf5;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}
.env-row {
  border-top: 1rpx solid rgba(193, 199, 206, 0.3);
  padding-top: 16rpx;
  margin-top: 4rpx;
  color: #41474d;
  font-size: 24rpx;
  flex-wrap: wrap;
}

/* 图例 */
.legend {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border: 1rpx solid rgba(193, 199, 206, 0.4);
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  font-size: 24rpx;
  color: #41474d;
}
.legend-strong { color: #121c2c; font-weight: 500; }
.swatch { width: 28rpx; height: 28rpx; border-radius: 8rpx; }
.swatch-free { background: #ffffff; border: 1rpx solid #d1d5db; }
.swatch-selected { background: #10b981; }
.swatch-occupied { background: #e5e7eb; }
.swatch-maintenance { background: #fef3c7; border: 1rpx solid #fde68a; }

/* 平面图卡片 */
.plan-card {
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.window-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #f9fafb;
  border: 1rpx dashed #d1d5db;
  border-radius: 16rpx;
  padding: 12rpx 24rpx;
  color: #41474d;
  font-size: 24rpx;
}
.window-text { font-weight: 500; }

.zone-head {
  padding-top: 8rpx;
}
.zone-dot { width: 12rpx; height: 28rpx; border-radius: 999rpx; }
.zone-dot-a { background: #059669; }
.zone-dot-b { background: #9ca3af; }
.zone-title { font-size: 26rpx; font-weight: 700; color: #121c2c; }
.outlet-pill {
  font-size: 22rpx;
  color: #047857;
  background: #ecfdf5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.zone-note { font-size: 22rpx; color: #41474d; }

.grid-a {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 16rpx;
}
.seat-a {
  height: 88rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  box-sizing: border-box;
}
.seat-a.occupied { background: #f3f4f6; color: #9ca3af; }
.seat-a.available { background: #ffffff; border: 1rpx solid #d1d5db; color: #121c2c; font-weight: 500; }
.seat-a.maintenance { background: #fffbeb; border: 1rpx solid #fde68a; color: #d97706; }
.seat-a.selected { background: #07c160; color: #ffffff; font-weight: 700; }
.seat-sub { font-size: 18rpx; }
.seat-a.available .seat-sub { color: #059669; }
.seat-a.selected .seat-sub { color: rgba(255, 255, 255, 0.9); }

.corridor {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 12rpx 24rpx;
  font-size: 22rpx;
  color: #41474d;
}

.grid-b {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 12rpx;
}
.seat-b {
  height: 72rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  box-sizing: border-box;
}
.seat-b.occupied { background: #f3f4f6; color: #9ca3af; }
.seat-b.available { background: #ffffff; border: 1rpx solid #d1d5db; color: #121c2c; font-weight: 500; }
.seat-b.maintenance { background: #fffbeb; border: 1rpx solid #fde68a; color: #d97706; font-size: 20rpx; }
.seat-b.selected { background: #07c160; color: #ffffff; }

/* 选中信息卡片 */
.select-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.seat-chip {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: #07c160;
  color: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 26rpx;
  flex-shrink: 0;
}
.chip-sub { font-size: 18rpx; font-weight: 400; opacity: 0.9; }
.chip-id { line-height: 1.2; }
.select-name { font-size: 30rpx; font-weight: 700; color: #121c2c; }
.select-desc { font-size: 24rpx; color: #41474d; }
.window-pill {
  font-size: 22rpx;
  color: #047857;
  background: #ecfdf5;
  border: 1rpx solid #a7f3d0;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}
.lock-label { font-size: 22rpx; color: #41474d; }
.lock-time { font-size: 28rpx; font-weight: 700; color: #059669; font-family: "Microsoft YaHei", "微软雅黑", sans-serif; }
.text-right { align-items: flex-end; }

.rules-well {
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 22rpx;
  color: #41474d;
  line-height: 1.6;
}
.amber { color: #d97706; }
.rules-title { color: #374151; font-weight: 500; }

.btn-reselect {
  height: 88rpx;
  padding: 0 32rpx;
  border-radius: 16rpx;
  border: 1rpx solid #d1d5db;
  background: #ffffff;
  color: #121c2c;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.btn-confirm {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  background: #07c160;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

<import src="../../templates/api-state.wxml"/><view class="page api-page"><template is="api-state" data="{{loading,error,needsLogin}}"/><view wx:if="{{availability}}" class="card col gap-md"><text class="headline-sm">{{resource.name}}</text><text class="body-sm muted">{{availability.slot.slotDate}} {{availability.slot.startTime}} — {{availability.slot.endTime}}</text><text wx:if="{{!availability.canReserve}}" class="error-text">{{availability.unavailableReason}}</text><view class="grid-a"><button wx:for="{{seats}}" wx:key="id" class="seat-a {{item.status}}" data-id="{{item.id}}" bindtap="selectSeat" disabled="{{item.status === 'occupied'}}">{{item.label}}</button></view><text class="caption muted">选中仅用于确认信息，最终结果以提交时的服务端可用状态为准。</text><button class="btn btn-primary" bindtap="confirmSeat" disabled="{{seatId === null || !availability.canReserve}}">确认选择</button></view></view>

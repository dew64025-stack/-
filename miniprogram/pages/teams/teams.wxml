<import src="../../templates/api-state.wxml"/><view class="page api-page"><template is="api-state" data="{{loading,error,needsLogin}}"/><block wx:if="{{detail}}"><view class="card col gap-sm"><text class="headline-sm">{{detail.title}}</text><text class="body-sm api-content">{{detail.goal}}</text><text class="caption muted">发起人：{{detail.leader.nickname || '未设置昵称'}} · {{detail.memberCount}} 位成员</text><view wx:for="{{detail.openRoles}}" wx:key="id" class="well">{{item.role}} · 招募 {{item.quantity}} 人</view><button wx:if="{{detail.canApply}}" class="btn btn-primary" bindtap="apply" disabled="{{busy}}">申请加入</button><button class="btn btn-outline" bindtap="contact">队伍沟通</button></view></block><block wx:else><button class="btn btn-primary" bindtap="create">创建队伍</button><view wx:for="{{teams}}" wx:key="id" class="card col gap-sm" data-id="{{item.id}}" bindtap="open"><text class="headline-sm">{{item.title}}</text><text class="body-sm muted">{{item.goal}}</text></view><text wx:if="{{!loading && !teams.length}}" class="api-empty">暂无队伍</text></block></view>

@import "./styles/mobile.wxss";
@import "./styles/search.wxss";
@import "./styles/api.wxss";

/* ===================================================================
   材智通 · 全局样式（Academic Nexus 设计系统）
   颜色令牌来自原始 HTML 的 Tailwind 配置（Academic Nexus）
   rpx 换算基准：375px 设计稿 = 750rpx，即 1px = 2rpx
   =================================================================== */

page {
  /* —— 颜色令牌 —— */
  --primary: #00324b;
  --on-primary: #ffffff;
  --primary-container: #1b4965;
  --on-primary-container: #8eb8d8;
  --secondary: #1a6b4a;
  --on-secondary: #ffffff;
  --secondary-container: #a5f3c9;
  --on-secondary-container: #237150;
  --secondary-fixed: #a5f3c9;
  --on-secondary-fixed-variant: #005235;
  --tertiary: #5c1600;
  --on-tertiary: #ffffff;
  --tertiary-container: #7f2708;
  --on-tertiary-container: #ff9878;
  --error: #ba1a1a;
  --on-error: #ffffff;
  --error-container: #ffdad6;
  --on-error-container: #93000a;
  --on-surface: #121c2c;
  --on-surface-variant: #41474d;
  --outline: #72787e;
  --outline-variant: #c1c7ce;
  --surface: #f9f9ff;
  --surface-low: #f0f3ff;
  --surface-container: #e7eeff;
  --surface-container-high: #dee8ff;
  --surface-container-highest: #d9e3f9;
  --surface-lowest: #ffffff;
  --wechat-green: #07c160;

  background: var(--surface);
  color: var(--on-surface);
  font-size: 28rpx;
  line-height: 1.5;
  font-family: "Microsoft YaHei", "微软雅黑", sans-serif;
  -webkit-font-smoothing: antialiased;
}

page view,
page text,
page button,
page input,
page textarea,
page picker,
page navigator,
page label,
page scroll-view {
  font-family: "Microsoft YaHei", "微软雅黑", sans-serif;
}

/* —— 页面容器 —— */
.page {
  padding: 24rpx 32rpx;
  box-sizing: border-box;
  padding-bottom: 60rpx;
}
.page-safe {
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}
.col {
  display: flex;
  flex-direction: column;
}
.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.flex-1 {
  flex: 1;
  min-width: 0;
}
.center {
  display: flex;
  align-items: center;
  justify-content: center;
}
.space-between {
  justify-content: space-between;
}
.wrap {
  flex-wrap: wrap;
}
.gap-xs { gap: 8rpx; }
.gap-sm { gap: 16rpx; }
.gap-md { gap: 24rpx; }

/* —— 文本层级 —— */
.headline-xl { font-size: 48rpx; font-weight: 700; line-height: 1.33; }
.headline-lg { font-size: 40rpx; font-weight: 600; line-height: 1.4; }
.headline-sm { font-size: 34rpx; font-weight: 600; line-height: 1.4; }
.title       { font-size: 32rpx; font-weight: 600; }
.body-lg     { font-size: 30rpx; font-weight: 400; line-height: 1.5; }
.body        { font-size: 28rpx; font-weight: 400; line-height: 1.5; }
.body-sm     { font-size: 24rpx; font-weight: 400; line-height: 1.5; }
.label-md    { font-size: 26rpx; font-weight: 600; line-height: 1.4; }
.label-sm    { font-size: 22rpx; font-weight: 500; line-height: 1.4; }
.caption     { font-size: 20rpx; font-weight: 500; line-height: 1.4; }
.page.main-tab-page .body-sm { font-size: 26rpx; line-height: 1.45; }
.page.main-tab-page .label-sm { font-size: 24rpx; line-height: 1.4; }
.page.main-tab-page .caption { font-size: 22rpx; line-height: 1.4; }
.page.main-tab-page input { font-size: 26rpx; }
.page.main-tab-page { gap: 28rpx; }
.page.main-tab-page .section-head,
.page.main-tab-page .sec-head {
  min-height: 64rpx;
  padding-top: 4rpx;
  padding-bottom: 12rpx;
}
.mono        { font-family: "Microsoft YaHei", "微软雅黑", sans-serif; }
.muted       { color: var(--on-surface-variant); }
.faint       { color: var(--outline); }
.primary-text   { color: var(--primary); }
.secondary-text { color: var(--secondary); }
.tertiary-text  { color: var(--tertiary); }
.error-text     { color: var(--error); }
.bold { font-weight: 700; }
.semibold { font-weight: 600; }
.truncate { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.text-center { text-align: center; }
.text-left { text-align: left; }

/* —— 卡片与容器 —— */
.card {
  background: var(--surface-lowest);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 1px 3px rgba(27, 73, 101, 0.04), 0 4px 12px rgba(27, 73, 101, 0.02);
  box-sizing: border-box;
}
.card-pad-sm { padding: 16rpx; }
.card-pad-lg { padding: 32rpx; }
.well {
  background: var(--surface-low);
  border-radius: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
}
.well-high {
  background: var(--surface-container);
  border-radius: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
}
.divider {
  height: 1rpx;
  background: var(--outline-variant);
  opacity: 0.6;
}
.hairline {
  border-bottom: 1rpx solid rgba(193, 199, 206, 0.5);
}

/* —— 徽章 / 药丸标签 —— */
.badge {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  white-space: nowrap;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.5;
  font-weight: 500;
}
.badge-primary   { background: var(--surface-container); color: var(--primary); }
.badge-secondary { background: var(--secondary-container); color: var(--on-secondary-container); }
.badge-tertiary  { background: var(--tertiary-container); color: var(--on-tertiary-container); }
.badge-error     { background: var(--error-container); color: var(--on-error-container); }
.badge-demo      { background: #edf2f7; color: #4a5568; }
.badge-outline   { background: var(--surface-low); color: var(--outline); }
.badge-green     { background: var(--secondary); color: var(--on-secondary); }
.badge-plain     { background: var(--surface-container-high); color: var(--on-surface-variant); }

/* —— 按钮 —— */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-sizing: border-box;
  padding: 0 24rpx;
}
.btn::after { border: none; }
.btn-primary {
  background: var(--primary);
  color: var(--on-primary);
  box-shadow: 0 2rpx 8rpx rgba(0, 50, 75, 0.18);
}
.btn-primary-container {
  background: var(--primary-container);
  color: var(--on-primary);
}
.btn-secondary {
  background: var(--secondary);
  color: var(--on-secondary);
}
.btn-outline {
  background: var(--surface-low);
  color: var(--primary);
}
.btn-ghost {
  background: var(--surface-container);
  color: var(--primary);
}
.btn-neutral {
  background: var(--surface-container);
  color: var(--on-surface);
}
.btn-sm {
  height: 72rpx;
  font-size: 24rpx;
  padding: 0 20rpx;
}
.btn-xs {
  height: 56rpx;
  font-size: 22rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
}
.btn:active { opacity: 0.88; transform: scale(0.99); }

/* —— 图标（emoji 替代 Material Symbols）—— */
.ico {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.ico-24 { font-size: 24rpx; }
.ico-28 { font-size: 28rpx; }
.ico-32 { font-size: 32rpx; }
.ico-40 { font-size: 40rpx; }
.ico-48 { font-size: 48rpx; }

/* —— 头像 / 圆形图标底座 —— */
.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--primary);
  color: var(--on-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}
.avatar-lg {
  width: 96rpx;
  height: 96rpx;
  font-size: 44rpx;
}
.icon-round {
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.icon-round-sm { width: 56rpx; height: 56rpx; font-size: 28rpx; }
.icon-round-md { width: 72rpx; height: 72rpx; font-size: 34rpx; }

/* —— 输入框 —— */
.input {
  height: 88rpx;
  border-radius: 16rpx;
  background: var(--surface-low);
  padding: 0 28rpx;
  font-size: 28rpx;
  color: var(--on-surface);
  box-sizing: border-box;
}
.placeholder { color: var(--outline); }

/* —— 分区标题 —— */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 8rpx;
}
.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--on-surface);
}

/* —— 通用占位图片块 —— */
.ph-image {
  background: linear-gradient(135deg, var(--surface-container-high), var(--surface-container));
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--primary);
  font-size: 22rpx;
  text-align: center;
  box-sizing: border-box;
  padding: 20rpx;
}

/* —— 列表项行 —— */
.list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}
.list-row + .list-row {
  border-top: 1rpx solid rgba(193, 199, 206, 0.4);
}

.api-state, .api-empty { padding: 24rpx 16rpx; text-align: center; color: var(--on-surface-variant); font-size: 26rpx; }
.api-error { white-space: pre-wrap; color: var(--error); }
.api-content { white-space: pre-wrap; overflow-wrap: break-word; }
.api-source { font-size: 22rpx; color: var(--on-surface-variant); }
.api-images { display: flex; flex-wrap: wrap; gap: 12rpx; }
.api-image { width: 144rpx; height: 144rpx; border-radius: 12rpx; }
.api-form-label { display: block; padding-bottom: 8rpx; font-weight: 600; }
.api-form-input { width: 100%; min-height: 88rpx; padding: 16rpx; background: var(--surface-container-low); border-radius: 14rpx; box-sizing: border-box; }
.api-form-textarea { width: 100%; min-height: 200rpx; padding: 16rpx; background: var(--surface-container-low); border-radius: 14rpx; box-sizing: border-box; }
.api-list { display: flex; flex-direction: column; gap: 24rpx; }
.api-actions { display: flex; gap: 16rpx; flex-wrap: wrap; }
.api-actions .btn { flex: 1; min-width: 160rpx; }
.api-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.api-picker { padding: 16rpx; background: var(--surface-container-low); border-radius: 14rpx; }
.api-page { display: flex; flex-direction: column; gap: 24rpx; padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }
.api-page .card { min-width: 0; }

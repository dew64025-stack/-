/* Shared mobile layout and semantic controls. */

page {
  width: 100%;
  min-height: 100%;
  box-sizing: border-box;
  --surface-container-lowest: #ffffff;
  --surface-container-low: #f0f3ff;
}

.page.page {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.page view,
.page scroll-view,
.page button,
.page input,
.page textarea {
  box-sizing: border-box;
}

.page .row > .col,
.page .row > .flex-1,
.page .row > text,
.page .col > view,
.page input,
.page textarea {
  min-width: 0;
}

.page input,
.page textarea,
.page image {
  max-width: 100%;
}

.page input.input,
.page textarea.input {
  width: 100%;
}

.page .card,
.page .well,
.page .well-high,
.page scroll-view {
  max-width: 100%;
}

.page .btn {
  width: auto;
  height: auto;
  min-height: 44px;
  padding-top: 16rpx;
  padding-bottom: 16rpx;
  white-space: normal;
  line-height: 1.45;
  text-align: center;
  overflow-wrap: break-word;
}

.page .btn-sm,
.page .btn-xs {
  min-height: 44px;
  padding-left: 16rpx;
  padding-right: 16rpx;
}

.page .link-btn {
  min-height: 44px;
  margin: 0;
  padding: 8rpx 4rpx;
  white-space: normal;
  line-height: 1.4;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.page .cat-btn,
.page .quick-pill {
  min-height: 44px;
}

.page .quick-pills {
  flex-wrap: wrap;
}

.page .badge {
  max-width: 100%;
  flex-shrink: 0;
  white-space: normal;
  overflow-wrap: break-word;
}

.page .toast,
.page .feedback-toast {
  max-width: calc(100% - 48rpx);
  box-sizing: border-box;
  overflow-wrap: break-word;
}

.page .dock,
.page .chat-dock,
.page .footer-bar,
.page .submit-bar {
  max-width: 100%;
  box-sizing: border-box;
}

.page .dock > .btn,
.page .footer-bar .footer-btn,
.page .submit-btn,
.page .btn-send {
  min-width: 0;
  min-height: 44px;
  height: auto;
  white-space: normal;
  line-height: 1.45;
}

.page .footer-bar .footer-btn,
.page .submit-btn,
.page .btn-send {
  padding-top: 14rpx;
  padding-bottom: 14rpx;
}

.precheck-page.precheck-page {
  padding-bottom: calc(340rpx + env(safe-area-inset-bottom));
}

.chat-page.chat-page {
  padding-bottom: calc(400rpx + env(safe-area-inset-bottom));
}

.detail-page.detail-page {
  padding-bottom: calc(260rpx + env(safe-area-inset-bottom));
}

.reserveconfirm-page.reserveconfirm-page {
  padding-bottom: calc(300rpx + env(safe-area-inset-bottom));
}

.page .input-bar,
.page .tool-row {
  gap: 12rpx;
}

.page .msg-row > .col {
  min-width: 0;
}

.page .bubble {
  overflow-wrap: break-word;
}

.page .grid-a,
.page .grid-b {
  grid-template-columns: repeat(6, minmax(0, 1fr));
}

.page .grid-b {
  grid-template-columns: repeat(8, minmax(0, 1fr));
}

.page .seat-a,
.page .seat-b {
  min-width: 0;
  min-height: 44px;
}

@media (max-width: 480px) {
  .page .grid-b {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}

@media (max-width: 360px) {
  .page.page {
    padding-left: 24rpx;
    padding-right: 24rpx;
  }

  .page .card {
    padding-left: 20rpx;
    padding-right: 20rpx;
  }

  .page .card-pad-0 {
    padding-left: 0;
    padding-right: 0;
  }

  .page .grid-a {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .page .sec-head,
  .page .section-head,
  .page .match-chip,
  .page .profile-card,
  .page .ctx-bottom,
  .page .agree-loc {
    flex-wrap: wrap;
    row-gap: 12rpx;
  }

  .page .dock {
    gap: 12rpx;
    padding-left: 24rpx;
    padding-right: 24rpx;
  }

  .page .input-bar,
  .page .tool-row,
  .page .quick-scroll {
    padding-left: 20rpx;
    padding-right: 20rpx;
  }

  .page .input-icon {
    width: 56rpx;
    flex-shrink: 0;
  }

  .page .btn-send {
    padding-left: 20rpx;
    padding-right: 20rpx;
  }
}

/* 微信小程序按钮样式 */
.page button:not(.nav-item) {
  display: flex;
  align-items: center;
  justify-content: center;

  width: auto;
  min-width: 0;
  max-width: 100%;
  min-height: 44px;
  height: auto;
  margin: 0;
  padding: 0 16px;

  box-sizing: border-box;
  border: 1px solid rgba(255, 255, 255, 0.9);
  border-radius: 999rpx;

  background: linear-gradient(145deg, #f8fafc, #e4e9f0);
  color: #24384c;
  font-family: inherit;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.35;
  text-align: center;
  white-space: normal;
  overflow-wrap: break-word;

  box-shadow: 0 15rpx 25rpx -4rpx rgba(27, 49, 71, 0.28),
    0 5rpx 10rpx rgba(27, 49, 71, 0.10),
    inset 0 -3rpx 4rpx -1rpx rgba(27, 49, 71, 0.10),
    0 -8rpx 12rpx -1rpx rgba(255, 255, 255, 0.8),
    inset 0 3rpx 4rpx -1rpx rgba(255, 255, 255, 0.7),
    inset 0 0 5rpx 1rpx rgba(255, 255, 255, 0.7);

  transition:
    transform 200ms cubic-bezier(0.23, 1, 0.32, 1),
    box-shadow 200ms ease,
    background-color 200ms ease;
}

/* 按功能分色：深海蓝主操作、草木绿完成操作、琥珀色提醒、红色危险操作。 */
.page button.btn-primary,
.page button.ai-submit,
.page button.search-btn,
.page button.publish-btn,
.page button.wx-login-btn,
.page button.btn-publish,
.page button.btn-submit-manual,
.page button.submit-btn,
.page button.upload-btn,
.page button.card-btn-primary,
.page button.btn-send {
  border: 1px solid rgba(255, 255, 255, 0.35);
  background: linear-gradient(145deg, #175574, #00324b);
  color: #ffffff;
  box-shadow: 0 15rpx 26rpx -5rpx rgba(0, 50, 75, 0.42),
    0 5rpx 10rpx rgba(0, 50, 75, 0.20),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.22),
    inset 0 -3rpx 5rpx rgba(0, 20, 32, 0.20);
}

.page button.btn-primary-container {
  border: 1px solid rgba(255, 255, 255, 0.45);
  background: linear-gradient(145deg, #39728e, #1b4965);
  color: #ffffff;
  box-shadow: 0 12rpx 22rpx -5rpx rgba(27, 73, 101, 0.36),
    0 4rpx 8rpx rgba(27, 73, 101, 0.16),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.22);
}

.page button.btn-secondary,
.page button.vote-btn,
.page button.tool-green {
  border: 1px solid rgba(255, 255, 255, 0.35);
  background: linear-gradient(145deg, #289163, #145a3d);
  color: #ffffff;
  box-shadow: 0 13rpx 23rpx -5rpx rgba(20, 90, 61, 0.38),
    0 4rpx 9rpx rgba(20, 90, 61, 0.18),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.20);
}

.page button.btn-warning {
  border: 1px solid rgba(255, 255, 255, 0.35);
  background: linear-gradient(145deg, #bd790b, #8b4b00);
  color: #ffffff;
  box-shadow: 0 12rpx 22rpx -5rpx rgba(139, 75, 0, 0.38),
    0 4rpx 8rpx rgba(139, 75, 0, 0.18),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.20);
}

.page button.btn-outline,
.page button.btn-ghost,
.page button.btn-neutral,
.page button.guest-btn,
.page button.skip-btn,
.page button.code-btn,
.page button.tool-neutral,
.page button.card-btn-ghost {
  border: 1px solid #cfdae4;
  background: linear-gradient(145deg, #ffffff, #eaf0f5);
  color: #17384d;
  box-shadow: 0 10rpx 18rpx -5rpx rgba(31, 58, 78, 0.24),
    0 3rpx 7rpx rgba(31, 58, 78, 0.12),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.95),
    inset 0 -2rpx 4rpx rgba(31, 58, 78, 0.06);
}

.page button.delete-btn,
.page button.btn-danger,
.page button.btn-cancel {
  border: 1px solid rgba(255, 255, 255, 0.35);
  background: linear-gradient(145deg, #d14b47, #a51f25);
  color: #ffffff;
  box-shadow: 0 12rpx 22rpx -5rpx rgba(165, 31, 37, 0.38),
    0 4rpx 8rpx rgba(165, 31, 37, 0.18),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.20);
}

.page button.link-btn,
.page button.star-btn {
  min-height: 44px;
  padding: 8rpx 4rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--primary);
  box-shadow: none;
}

.page button.list-btn {
  min-height: 64rpx;
  padding: 20rpx 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--on-surface);
  box-shadow: none;
}

.page button.quick-item {
  min-height: 0;
  padding: 24rpx 8rpx;
  border: 0;
  border-radius: 20rpx;
  background: var(--surface-container-low);
  color: var(--on-surface);
  box-shadow: none;
}

.page button.btn-disabled,
.page button[disabled] {
  opacity: 0.55;
  box-shadow: none;
}

/* 微信小程序按压状态 */
.page button[class*="-hover"] {
  transform: translateY(2rpx);
  box-shadow: inset 0 6rpx 14rpx rgba(27, 49, 71, 0.14),
    inset 0 -3rpx 8rpx rgba(255, 255, 255, 0.8),
    0 2rpx 4rpx rgba(27, 49, 71, 0.08);
}

/* 小按钮适配 */
.page .btn-sm,
.page .btn-xs {
  min-height: 44px;
  padding-left: 12px;
  padding-right: 12px;
}

/* 防止按钮内部内容溢出 */
.page button text,
.page button view,
.page button image {
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

/* 按钮图片图标间距 */
.page button image {
  margin-right: 22rpx;
  flex-shrink: 0;
}

.page button[disabled] {
  opacity: 0.55;
  box-shadow: none;
}

@media (prefers-reduced-motion: reduce) {
  .page button {
    animation: none;
    transition: none;
  }
}
